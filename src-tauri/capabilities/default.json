{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top",
    "allow-list-event-types",
    "allow-save-event-type",
    "allow-archive-event-type",
    "allow-delete-event-type",
    "allow-list-time-entries",
    "allow-save-time-entry",
    "allow-delete-time-entry",
    "allow-list-notes",
    "allow-get-note",
    "allow-save-note",
    "allow-delete-note",
    "allow-set-autostart",
    "allow-exit-app",
    "allow-save-window-geometry",
    "allow-set-main-window-mode",
    "allow-open-note-window",
    "allow-set-note-always-on-top",
    "allow-get-shortcut-status",
    "allow-set-global-shortcut",
    "allow-get-performance-settings",
    "allow-preview-performance-retention",
    "allow-save-performance-settings",
    "allow-list-work-types",
    "allow-save-work-type",
    "allow-list-cycle-goals",
    "allow-save-cycle-goal",
    "allow-save-work-output",
    "allow-delete-work-output",
    "allow-set-work-day-override",
    "allow-list-work-day-overrides",
    "allow-list-work-days"]
}
